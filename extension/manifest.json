{
  "manifest_version": 3,
  "name": "AI Calendar Manager",
  "version": "0.1.0",
  "description": "Tasks, approvals, and chat for your AI calendar manager, injected into Notion Calendar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Calendar Manager — options"
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://calendar.notion.so/*"],
      "js": ["content-script.ts"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://calendar.notion.so/*",
    "https://motiondupelol.vercel.app/*"
  ]
}
